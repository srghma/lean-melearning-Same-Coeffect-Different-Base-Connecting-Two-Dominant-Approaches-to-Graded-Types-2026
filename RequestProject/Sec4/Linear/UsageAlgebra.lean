module

public import RequestProject.Sec2.Linear.Typing

/-!
# Algebra of Linear Base contexts

Auxiliary algebra on Linear Base usages (`Use R` and contexts `Fin n → Use R`) needed for the
substitution lemma of the derivation-based translation into Graded Poly Base:

* an explicit (total) addition `Use.plus`, which is the value of the partial addition `Use.Add`
  whenever the latter is defined (this keeps all constructions choice-free);
* the order `Use.Le` generated by weakening (`none ⊑ [·]_b` when `0 ⊑ b`) and approximation;
* finite sums of contexts `SumF` and the usage `SubstUse u v w` of a simultaneous substitution:
  if `t` uses its variables according to `u`, and the `i`-th substituted term uses `v i`, then
  the substituted term uses `w = Σᵢ u i ⊙ v i`.
-/

@[expose] public section

namespace Coeffect

universe u

variable {R : Type u}

namespace Use

/-- Total version of context addition (with an arbitrary value where `Use.Add` is undefined). -/
def plus [HAdd R R R] : Use R → Use R → Use R
  | none, v => v
  | lin, none => lin
  | lin, _ => lin
  | grd r, none => grd r
  | grd r, grd s => grd (r + s)
  | grd r, lin => grd r

lemma Add.eq_plus [HAdd R R R] {a b c : Use R} (h : Add a b c) : c = plus a b := by
  cases a <;> cases b <;> cases h <;> rfl

/-- The singleton context: `x` at position `i`, `none` elsewhere. -/
def single {n : ℕ} (i : Fin n) (x : Use R) : Fin n → Use R := fun j => if j = i then x else none

/-- The order on usages generated by weakening and approximation. -/
inductive Le [Preorder R] [Zero R] : Use R → Use R → Prop
  | none : Le none none
  | lin : Le lin lin
  | grd {a b : R} : a ≤ b → Le (grd a) (grd b)
  | noneGrd {b : R} : 0 ≤ b → Le none (grd b)

lemma Le.refl [Preorder R] [Zero R] (a : Use R) : Le a a := by
  cases a with
  | none => exact .none
  | lin => exact .lin
  | grd r => exact .grd le_rfl

end Use

/-- Pointwise order on contexts. -/
def UsageLe [Preorder R] [Zero R] {n : ℕ} (u u' : Fin n → Use R) : Prop :=
  ∀ j, Use.Le (u j) (u' j)

/-- Total pointwise addition of contexts. -/
def plusCtx [HAdd R R R] {n : ℕ} (u₁ u₂ : Fin n → Use R) : Fin n → Use R :=
  fun j => Use.plus (u₁ j) (u₂ j)

/-- `u ⊙ v`: the contribution of a variable used according to `u` and substituted by a term
used according to `v`. -/
def scaleU [Mul R] {m : ℕ} : Use R → (Fin m → Use R) → Fin m → Use R
  | .none, _ => emptyU
  | .lin, v => v
  | .grd r, v => smulCtx r v

/-- `SumF f w`: the contexts `f i` can be added up (in order) with result `w`. -/
def SumF [HAdd R R R] {m : ℕ} : {n : ℕ} → (Fin n → Fin m → Use R) → (Fin m → Use R) → Prop
  | 0, _, w => w = emptyU
  | _ + 1, f, w => ∃ w', SumF (fun i => f i.succ) w' ∧ CtxAdd (f 0) w' w

/-- `SubstUse u v w`: substituting, for each variable `i` used according to `u i`, a term used
according to `v i` (which must be graded if `u i` is graded) gives a term used according to
`w = Σᵢ u i ⊙ v i`. -/
def SubstUse [Add R] [Mul R] {n m : ℕ} (u : Fin n → Use R) (v : Fin n → Fin m → Use R)
    (w : Fin m → Use R) : Prop :=
  (∀ i r, u i = Use.grd r → Graded (v i)) ∧ SumF (fun i => scaleU (u i) (v i)) w

/-- The usages of the identity substitution (variables substituted for graded variables are
derelicted). -/
def idUse {n : ℕ} [One R] (u : Fin n → Use R) : Fin n → Fin n → Use R :=
  fun i => match u i with
    | .grd _ => Use.single i (.grd 1)
    | _ => Use.only i

section Algebra

variable [PreorderedSemiring R]

namespace Use

lemma Add.comm {a b c : Use R} (h : Add a b c) : Add b a c := by
  cases h with
  | noneLeft => exact .noneRight _
  | noneRight => exact .noneLeft _
  | grd r s => rw [add_comm]; exact .grd s r

lemma Add.det {a b c c' : Use R} (h : Add a b c) (h' : Add a b c') : c = c' := by
  rw [h.eq_plus, h'.eq_plus]

lemma Add.assoc {a b c ab abc : Use R} (h₁ : Add a b ab) (h₂ : Add ab c abc) :
    Add b c (plus b c) ∧ Add a (plus b c) abc := by
  cases h₁ with
  | noneLeft =>
    refine ⟨?_, ?_⟩
    · rw [← h₂.eq_plus]; exact h₂
    · rw [← h₂.eq_plus]; exact .noneLeft _
  | noneRight => exact ⟨.noneLeft _, h₂⟩
  | grd r s =>
    cases h₂ with
    | noneRight => exact ⟨.noneRight _, .grd r s⟩
    | grd _ t => refine ⟨.grd s t, ?_⟩; rw [add_assoc]; exact .grd r (s + t)

lemma Add.smul (r : R) {a b c : Use R} (h : Add a b c) :
    Add (a.smul r) (b.smul r) (c.smul r) := by
  cases h with
  | noneLeft => exact .noneLeft _
  | noneRight => exact .noneRight _
  | grd s t => simp only [Use.smul, mul_add]; exact .grd _ _

lemma plus_none (a : Use R) : plus a none = a := by cases a <;> rfl

lemma Add.assoc' {a c e ce z : Use R} (h₁ : Add c e ce) (h₂ : Add a ce z) :
    Add a c (plus a c) ∧ Add (plus a c) e z := by
  cases h₁ with
  | noneLeft => rw [plus_none]; exact ⟨.noneRight _, h₂⟩
  | noneRight =>
    refine ⟨?_, ?_⟩ <;> rw [← h₂.eq_plus]
    · exact h₂
    · exact .noneRight _
  | grd r s =>
    cases h₂ with
    | noneLeft => exact ⟨.noneLeft _, .grd r s⟩
    | grd t _ => refine ⟨.grd t r, ?_⟩; rw [← add_assoc]; exact .grd (t + r) s

lemma Add.interchange {a b c d x y z : Use R} (hx : Add a b x) (hy : Add c d y)
    (hz : Add x y z) :
    Add a c (plus a c) ∧ Add b d (plus b d) ∧ Add (plus a c) (plus b d) z := by
  obtain ⟨hby, hz1⟩ := hx.assoc hz
  obtain ⟨hdb, hc⟩ := hy.assoc hby.comm
  obtain ⟨hac, hfin⟩ := hc.assoc' hz1
  have e : plus d b = plus b d := hdb.comm.eq_plus
  rw [e] at hfin hdb
  exact ⟨hac, hdb.comm, hfin⟩

/-- Down-closure: if `a' + b` is defined and `a ⊑ a'`, then `a + b` is defined and below. -/
lemma Add.down {a a' b c' : Use R} (h : Add a' b c') (ha : Le a a') :
    Add a b (plus a b) ∧ Le (plus a b) c' := by
  cases ha with
  | none =>
    refine ⟨.noneLeft _, ?_⟩; rw [h.eq_plus]; exact Le.refl _
  | lin =>
    refine ⟨?_, ?_⟩ <;> rw [← h.eq_plus]
    · exact h
    · exact Le.refl _
  | @grd x y hxy =>
    cases h with
    | noneRight => exact ⟨.noneRight _, .grd hxy⟩
    | grd _ z => exact ⟨.grd x z, .grd (PreorderedSemiring.add_mono hxy le_rfl)⟩
  | @noneGrd y hy =>
    cases h with
    | noneRight => exact ⟨.noneLeft _, .noneGrd hy⟩
    | grd _ z =>
      refine ⟨.noneLeft _, .grd ?_⟩
      calc z = 0 + z := (zero_add z).symm
        _ ≤ y + z := PreorderedSemiring.add_mono hy le_rfl

end Use

/-! ## Contexts -/

section Ctx

variable {m : ℕ}

lemma CtxAdd.comm {a b c : Fin m → Use R} (h : CtxAdd a b c) : CtxAdd b a c :=
  fun j => (h j).comm

lemma CtxAdd.det {a b c c' : Fin m → Use R} (h : CtxAdd a b c) (h' : CtxAdd a b c') : c = c' :=
  funext fun j => (h j).det (h' j)

lemma CtxAdd.eq_plus {a b c : Fin m → Use R} (h : CtxAdd a b c) : c = plusCtx a b :=
  funext fun j => (h j).eq_plus

lemma CtxAdd.assoc {a b c ab abc : Fin m → Use R} (h₁ : CtxAdd a b ab) (h₂ : CtxAdd ab c abc) :
    CtxAdd b c (plusCtx b c) ∧ CtxAdd a (plusCtx b c) abc :=
  ⟨fun j => ((h₁ j).assoc (h₂ j)).1, fun j => ((h₁ j).assoc (h₂ j)).2⟩

/-- `(a + b) + (c + d) = (a + c) + (b + d)`. -/
lemma CtxAdd.interchange {a b c d x y z : Fin m → Use R} (hx : CtxAdd a b x) (hy : CtxAdd c d y)
    (hz : CtxAdd x y z) :
    CtxAdd a c (plusCtx a c) ∧ CtxAdd b d (plusCtx b d) ∧
      CtxAdd (plusCtx a c) (plusCtx b d) z :=
  ⟨fun j => ((hx j).interchange (hy j) (hz j)).1,
   fun j => ((hx j).interchange (hy j) (hz j)).2.1,
   fun j => ((hx j).interchange (hy j) (hz j)).2.2⟩

lemma CtxAdd.smul (r : R) {a b c : Fin m → Use R} (h : CtxAdd a b c) :
    CtxAdd (smulCtx r a) (smulCtx r b) (smulCtx r c) :=
  fun j => (h j).smul r

lemma CtxAdd.down {a a' b c' : Fin m → Use R} (h : CtxAdd a' b c') (ha : UsageLe a a') :
    CtxAdd a b (plusCtx a b) ∧ UsageLe (plusCtx a b) c' :=
  ⟨fun j => ((h j).down (ha j)).1, fun j => ((h j).down (ha j)).2⟩

end Ctx

lemma Use.Le.trans {a b c : Use R} (h₁ : Use.Le a b) (h₂ : Use.Le b c) : Use.Le a c := by
  cases h₁ with
  | none => exact h₂
  | lin => exact h₂
  | grd h => cases h₂ with
    | grd h' => exact .grd (le_trans h h')
  | noneGrd h => cases h₂ with
    | grd h' => exact .noneGrd (le_trans h h')

lemma UsageLe.refl {m : ℕ} (u : Fin m → Use R) : UsageLe u u := fun _ => Use.Le.refl _

lemma UsageLe.trans {m : ℕ} {u v w : Fin m → Use R} (h₁ : UsageLe u v) (h₂ : UsageLe v w) :
    UsageLe u w := fun j => (h₁ j).trans (h₂ j)

lemma Use.Add.plus_graded {a b : Use R} (ha : a ≠ Use.lin) (hb : b ≠ Use.lin) :
    Use.Add a b (Use.plus a b) ∧ Use.plus a b ≠ Use.lin := by
  cases a with
  | none => exact ⟨.noneLeft _, hb⟩
  | lin => exact absurd rfl ha
  | grd r =>
    cases b with
    | none => exact ⟨.noneRight _, fun h => by cases h⟩
    | lin => exact absurd rfl hb
    | grd s => exact ⟨.grd r s, fun h => by cases h⟩

lemma Graded.smulCtx {m : ℕ} {v : Fin m → Use R} (hv : Graded v) (r : R) :
    Graded (smulCtx r v) := by
  intro j h
  simp only [Coeffect.smulCtx] at h
  cases e : v j with
  | none => rw [e] at h; cases h
  | lin => exact hv j e
  | grd q => rw [e] at h; cases h

omit [PreorderedSemiring R] in
lemma Graded.emptyU {m : ℕ} : Graded (emptyU : Fin m → Use R) := fun _ h => by cases h

lemma smulCtx_one {m : ℕ} (v : Fin m → Use R) : smulCtx 1 v = v := by
  funext j; simp only [smulCtx]
  cases v j with
  | none => rfl
  | lin => rfl
  | grd q => simp [Use.smul]

lemma smulCtx_smulCtx {m : ℕ} (r s : R) (v : Fin m → Use R) :
    smulCtx r (smulCtx s v) = smulCtx (r * s) v := by
  funext j; simp only [smulCtx]
  cases v j with
  | none => rfl
  | lin => rfl
  | grd q => simp [Use.smul, mul_assoc]

lemma smulCtx_emptyU {m : ℕ} (r : R) : smulCtx r (emptyU : Fin m → Use R) = emptyU := rfl

/-! ## Finite sums of contexts -/

section Sum

variable {m : ℕ}

lemma SumF.det : ∀ {n : ℕ} {f : Fin n → Fin m → Use R} {w w' : Fin m → Use R},
    SumF f w → SumF f w' → w = w'
  | 0, _, _, _, h, h' => h.trans h'.symm
  | _ + 1, _, _, _, ⟨_, ha, hadd⟩, ⟨_, hb, hadd'⟩ => by
    rw [SumF.det ha hb] at hadd
    exact hadd.det hadd'

lemma SumF.split : ∀ {n : ℕ} {f g h : Fin n → Fin m → Use R} {w : Fin m → Use R},
    (∀ i, CtxAdd (f i) (g i) (h i)) → SumF h w →
    ∃ w₁ w₂, SumF f w₁ ∧ SumF g w₂ ∧ CtxAdd w₁ w₂ w
  | 0, _, _, _, _, _, hw => ⟨emptyU, emptyU, rfl, rfl, by rw [hw]; exact CtxAdd.emptyLeft _⟩
  | _ + 1, f, g, _, _, hfg, ⟨w', hw', hadd⟩ => by
    obtain ⟨w₁, w₂, h₁, h₂, h₁₂⟩ := SumF.split (fun i => hfg i.succ) hw'
    obtain ⟨ha, hb, hc⟩ := (hfg 0).interchange h₁₂ hadd
    exact ⟨plusCtx (f 0) w₁, plusCtx (g 0) w₂, ⟨w₁, h₁, ha⟩, ⟨w₂, h₂, hb⟩, hc⟩

lemma SumF.down : ∀ {n : ℕ} {f f' : Fin n → Fin m → Use R} {w' : Fin m → Use R},
    (∀ i, UsageLe (f i) (f' i)) → SumF f' w' → ∃ w, SumF f w ∧ UsageLe w w'
  | 0, _, _, _, _, hw => ⟨emptyU, rfl, by rw [hw]; exact UsageLe.refl _⟩
  | _ + 1, f, _, _, hle, ⟨x', hx', hadd⟩ => by
    obtain ⟨x, hx, hxle⟩ := SumF.down (fun i => hle i.succ) hx'
    obtain ⟨h1, hle1⟩ := hadd.down (hle 0)
    obtain ⟨h2, hle2⟩ := h1.comm.down hxle
    exact ⟨plusCtx x (f 0), ⟨x, hx, h2.comm⟩, hle2.trans hle1⟩

lemma SumF.smul (r : R) : ∀ {n : ℕ} {f : Fin n → Fin m → Use R} {w : Fin m → Use R},
    SumF f w → SumF (fun i => smulCtx r (f i)) (smulCtx r w)
  | 0, _, _, hw => by rw [hw]; rfl
  | _ + 1, _, _, ⟨w', hw', hadd⟩ => ⟨smulCtx r w', SumF.smul r hw', hadd.smul r⟩

lemma SumF.exists_graded : ∀ {n : ℕ} {f : Fin n → Fin m → Use R},
    (∀ i, Graded (f i)) → ∃ w, SumF f w ∧ Graded w
  | 0, _, _ => ⟨emptyU, rfl, Graded.emptyU⟩
  | _ + 1, f, hf => by
    obtain ⟨w', hw', hg'⟩ := SumF.exists_graded (fun i => hf i.succ)
    refine ⟨plusCtx (f 0) w', ⟨w', hw', fun j => ?_⟩, fun j => ?_⟩
    · exact (Use.Add.plus_graded (hf 0 j) (hg' j)).1
    · exact (Use.Add.plus_graded (hf 0 j) (hg' j)).2

lemma SumF.empty : ∀ {n : ℕ} {f : Fin n → Fin m → Use R}, (∀ i, f i = emptyU) → SumF f emptyU
  | 0, _, _ => rfl
  | _ + 1, _, hf => ⟨emptyU, SumF.empty (fun i => hf i.succ), by rw [hf 0]; exact CtxAdd.emptyLeft _⟩

lemma SumF.cons_none : ∀ {n : ℕ} {f : Fin n → Fin m → Use R} {w : Fin m → Use R},
    SumF f w → SumF (fun i => Use.none .: f i) (Use.none .: w)
  | 0, _, _, hw => by rw [hw]; funext j; exact Fin.cases rfl (fun _ => rfl) j
  | _ + 1, _, _, ⟨w', hw', hadd⟩ =>
    ⟨Use.none .: w', SumF.cons_none hw', CtxAdd.cons (.noneLeft _) hadd⟩

lemma SumF.ite : ∀ {n : ℕ} (i : Fin n) (x : Fin m → Use R),
    SumF (fun j => if j = i then x else emptyU) x
  | 0, i, _ => Fin.elim0 i
  | n + 1, i, x => by
    refine Fin.cases ?_ (fun i => ?_) i
    · refine ⟨emptyU, SumF.empty (fun j => ?_), ?_⟩
      · dsimp only; rw [if_neg (Fin.succ_ne_zero j)]
      · dsimp only; rw [if_pos rfl]; exact CtxAdd.emptyRight _
    · refine ⟨x, ?_, ?_⟩
      · have e : (fun j : Fin n => if j.succ = i.succ then x else emptyU) =
            fun j => if j = i then x else emptyU := by
          funext j
          by_cases h : j = i
          · rw [if_pos h, if_pos (congrArg Fin.succ h)]
          · rw [if_neg h, if_neg (fun e => h (Fin.succ_injective _ e))]
        show SumF (fun j : Fin n => if j.succ = i.succ then x else emptyU) x
        rw [e]; exact SumF.ite i x
      · dsimp only; rw [if_neg (Fin.succ_ne_zero i).symm]; exact CtxAdd.emptyLeft _

lemma SumF.single : ∀ {n : ℕ} (a : Fin n → Use R), SumF (fun i => Use.single i (a i)) a
  | 0, a => by funext j; exact Fin.elim0 j
  | n + 1, a => by
    refine ⟨Use.none .: (fun i => a i.succ), ?_, ?_⟩
    · have e : (fun i : Fin n => Use.single i.succ (a i.succ)) =
          fun i => Use.none .: Use.single i (a i.succ) := by
        funext i j
        refine Fin.cases ?_ (fun j => ?_) j
        · simp only [Use.single, scons_zero]; rw [if_neg (Fin.succ_ne_zero i).symm]
        · simp only [Use.single, scons_succ]
          by_cases h : j = i
          · rw [if_pos h, if_pos (congrArg Fin.succ h)]
          · rw [if_neg h, if_neg (fun e => h (Fin.succ_injective _ e))]
      show SumF (fun i : Fin n => Use.single i.succ (a i.succ)) _
      rw [e]; exact SumF.cons_none (SumF.single _)
    · intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp only [Use.single, scons_zero, ↓reduceIte]; exact .noneRight _
      · simp only [Use.single, scons_succ]; rw [if_neg (Fin.succ_ne_zero j)]; exact .noneLeft _

end Sum

/-! ## Usages of simultaneous substitutions -/

section Subst

variable {n m : ℕ}

lemma scaleU_cons_none (a : Use R) (v : Fin m → Use R) :
    scaleU a (Use.none .: v) = Use.none .: scaleU a v := by
  funext j
  refine Fin.cases ?_ (fun j => ?_) j <;> cases a <;> rfl

lemma scaleU_graded {a : Use R} {v : Fin m → Use R} (ha : a ≠ Use.lin) (hv : Graded v) :
    Graded (scaleU a v) := by
  cases a with
  | none => exact Graded.emptyU
  | lin => exact absurd rfl ha
  | grd r => exact hv.smulCtx r

/-- `⊙` distributes over addition of usages. -/
lemma scaleU_add {a b c : Use R} (h : Use.Add a b c) {v : Fin m → Use R}
    (hv : ∀ r, c = Use.grd r → Graded v) :
    CtxAdd (scaleU a v) (scaleU b v) (scaleU c v) := by
  cases h with
  | noneLeft => exact CtxAdd.emptyLeft _
  | noneRight => exact CtxAdd.emptyRight _
  | grd r s =>
    intro j
    simp only [scaleU, smulCtx]
    cases e : v j with
    | none => exact .noneLeft _
    | lin => exact absurd e (hv _ rfl j)
    | grd q => simp only [Use.smul]; rw [add_mul]; exact .grd _ _

lemma SubstUse.var {i : Fin n} {v : Fin n → Fin m → Use R} {w : Fin m → Use R}
    (h : SubstUse (Use.only i) v w) : w = v i := by
  have e : (fun j => scaleU (Use.only i j) (v j)) = fun j => if j = i then v i else emptyU := by
    funext j
    by_cases hj : j = i
    · subst hj; simp only [Use.only]; rfl
    · simp only [Use.only, if_neg hj]; rfl
  have h2 := h.2
  rw [e] at h2
  exact h2.det (SumF.ite i (v i))

lemma SubstUse.cons_lin {u : Fin n → Use R} {v : Fin n → Fin m → Use R} {w : Fin m → Use R}
    (h : SubstUse u v w) :
    SubstUse (Use.lin .: u) (Use.only 0 .: fun i => Use.none .: v i) (Use.lin .: w) := by
  refine ⟨fun i r hi => ?_, ⟨Use.none .: w, ?_, ?_⟩⟩
  · induction i using Fin.cases with
    | zero => cases hi
    | succ i =>
      intro j hj
      induction j using Fin.cases with
      | zero => cases hj
      | succ j => exact h.1 i r hi j hj
  · show SumF (fun i => scaleU (u i) (Use.none .: v i)) _
    simp only [scaleU_cons_none]; exact SumF.cons_none h.2
  · intro j
    induction j using Fin.cases with
    | zero => exact .noneRight _
    | succ j => exact .noneLeft _

lemma SubstUse.cons_grd (r : R) {u : Fin n → Use R} {v : Fin n → Fin m → Use R}
    {w : Fin m → Use R} (h : SubstUse u v w) :
    SubstUse (Use.grd r .: u) (Use.single 0 (Use.grd 1) .: fun i => Use.none .: v i)
      (Use.grd r .: w) := by
  refine ⟨fun i s hi => ?_, ⟨Use.none .: w, ?_, ?_⟩⟩
  · induction i using Fin.cases with
    | zero =>
      intro j hj
      induction j using Fin.cases with
      | zero => cases hj
      | succ j => cases hj
    | succ i =>
      intro j hj
      induction j using Fin.cases with
      | zero => cases hj
      | succ j => exact h.1 i s hi j hj
  · show SumF (fun i => scaleU (u i) (Use.none .: v i)) _
    simp only [scaleU_cons_none]; exact SumF.cons_none h.2
  · intro j
    induction j using Fin.cases with
    | zero =>
      show Use.Add (Use.smul r (if (0 : Fin (m + 1)) = 0 then Use.grd 1 else Use.none)) _ _
      rw [if_pos rfl]; simp only [Use.smul, mul_one]; exact .noneRight _
    | succ j =>
      show Use.Add (Use.smul r (if j.succ = 0 then Use.grd 1 else Use.none)) _ _
      rw [if_neg (Fin.succ_ne_zero j)]; exact .noneLeft _

lemma Use.Add.grd_left {r : R} {b c : Use R} (h : Use.Add (Use.grd r) b c) : ∃ s, c = Use.grd s := by
  cases h with
  | noneRight => exact ⟨r, rfl⟩
  | grd _ s => exact ⟨_, rfl⟩

lemma SubstUse.split {u₁ u₂ u : Fin n → Use R} (hadd : CtxAdd u₁ u₂ u)
    {v : Fin n → Fin m → Use R} {w : Fin m → Use R} (h : SubstUse u v w) :
    ∃ w₁ w₂, SubstUse u₁ v w₁ ∧ SubstUse u₂ v w₂ ∧ CtxAdd w₁ w₂ w := by
  obtain ⟨w₁, w₂, h₁, h₂, h₁₂⟩ :=
    SumF.split (fun i => scaleU_add (hadd i) (fun r hr => h.1 i r hr)) h.2
  refine ⟨w₁, w₂, ⟨fun i r hi => ?_, h₁⟩, ⟨fun i r hi => ?_, h₂⟩, h₁₂⟩
  · have := hadd i; rw [hi] at this
    obtain ⟨s, hs⟩ := Use.Add.grd_left this
    exact h.1 i s hs
  · have := hadd i; rw [hi] at this
    obtain ⟨s, hs⟩ := Use.Add.grd_left this.comm
    exact h.1 i s hs

lemma SubstUse.weak {u : Fin n → Use R} {i : Fin n} (hi : u i = Use.none)
    {v : Fin n → Fin m → Use R} {w : Fin m → Use R}
    (h : SubstUse (Function.update u i (Use.grd 0)) v w) :
    ∃ w₀, SubstUse u v w₀ ∧ UsageLe w₀ w := by
  have hgi : Graded (v i) := h.1 i 0 (Function.update_self _ _ _)
  have hle' : ∀ j, UsageLe (scaleU (u j) (v j))
      (scaleU (Function.update u i (Use.grd 0) j) (v j)) := by
    intro j
    by_cases hji : j = i
    · subst hji
      rw [hi, Function.update_self]
      intro k
      simp only [scaleU, emptyU, smulCtx]
      cases e : v j k with
      | none => exact .none
      | lin => exact absurd e (hgi k)
      | grd q => simp only [Use.smul, zero_mul]; exact .noneGrd le_rfl
    · rw [Function.update_of_ne hji]; exact UsageLe.refl _
  obtain ⟨w₀, h₀, hle⟩ := SumF.down (f := fun j => scaleU (u j) (v j)) hle' h.2
  refine ⟨w₀, ⟨fun j r hj => ?_, h₀⟩, hle⟩
  by_cases hji : j = i
  · subst hji; rw [hi] at hj; cases hj
  · exact h.1 j r (by rw [Function.update_of_ne hji]; exact hj)

lemma SubstUse.approx {u : Fin n → Use R} {i : Fin n} {r s : R} (hi : u i = Use.grd r)
    (hrs : r ≤ s) {v : Fin n → Fin m → Use R} {w : Fin m → Use R}
    (h : SubstUse (Function.update u i (Use.grd s)) v w) :
    ∃ w₀, SubstUse u v w₀ ∧ UsageLe w₀ w := by
  have hgi : Graded (v i) := h.1 i s (Function.update_self _ _ _)
  have hle' : ∀ j, UsageLe (scaleU (u j) (v j))
      (scaleU (Function.update u i (Use.grd s) j) (v j)) := by
    intro j
    by_cases hji : j = i
    · subst hji
      rw [hi, Function.update_self]
      intro k
      simp only [scaleU, smulCtx]
      cases v j k with
      | none => exact .none
      | lin => exact .lin
      | grd q => exact .grd (PreorderedSemiring.mul_mono hrs le_rfl)
    · rw [Function.update_of_ne hji]; exact UsageLe.refl _
  obtain ⟨w₀, h₀, hle⟩ := SumF.down (f := fun j => scaleU (u j) (v j)) hle' h.2
  refine ⟨w₀, ⟨fun j r' hj => ?_, h₀⟩, hle⟩
  by_cases hji : j = i
  · subst hji; exact hgi
  · exact h.1 j r' (by rw [Function.update_of_ne hji]; exact hj)

lemma SubstUse.der {u : Fin n → Use R} {i : Fin n} (hi : u i = Use.lin)
    {v : Fin n → Fin m → Use R} {w : Fin m → Use R}
    (h : SubstUse (Function.update u i (Use.grd 1)) v w) : SubstUse u v w := by
  refine ⟨fun j r hj => ?_, ?_⟩
  · by_cases hji : j = i
    · subst hji; rw [hi] at hj; cases hj
    · exact h.1 j r (by rw [Function.update_of_ne hji]; exact hj)
  · have e : (fun j => scaleU (Function.update u i (Use.grd 1) j) (v j)) =
        fun j => scaleU (u j) (v j) := by
      funext j
      by_cases hji : j = i
      · subst hji; rw [hi, Function.update_self]; exact smulCtx_one _
      · rw [Function.update_of_ne hji]
    have h2 := h.2; rw [e] at h2; exact h2

lemma SubstUse.smul {u : Fin n → Use R} (hu : Graded u) (r : R)
    {v : Fin n → Fin m → Use R} {w : Fin m → Use R} (h : SubstUse (smulCtx r u) v w) :
    ∃ w', SubstUse u v w' ∧ Graded w' ∧ w = smulCtx r w' := by
  have hcond : ∀ i s, u i = Use.grd s → Graded (v i) := fun i s hi =>
    h.1 i (r * s) (by simp only [smulCtx, hi, Use.smul])
  obtain ⟨w', hw', hg⟩ := SumF.exists_graded (f := fun i => scaleU (u i) (v i)) (fun i => by
    show Graded (scaleU (u i) (v i))
    cases e : u i with
    | none => exact Graded.emptyU
    | lin => exact absurd e (hu i)
    | grd s => exact (hcond i s e).smulCtx s)
  refine ⟨w', ⟨hcond, hw'⟩, hg, ?_⟩
  have e : (fun i => scaleU (smulCtx r u i) (v i)) = fun i => smulCtx r (scaleU (u i) (v i)) := by
    funext i
    simp only [smulCtx]
    cases e : u i with
    | none => rfl
    | lin => exact absurd e (hu i)
    | grd s => simp only [Use.smul, scaleU]; rw [← smulCtx_smulCtx]
  have h2 := h.2; rw [e] at h2
  exact h2.det (hw'.smul r)

/-- The identity substitution. -/
lemma SubstUse.id (u : Fin n → Use R) : SubstUse u (idUse u) u := by
  refine ⟨fun i r hi => ?_, ?_⟩
  · simp only [idUse, hi]
    intro j hj
    simp only [Use.single] at hj
    by_cases hji : j = i
    · rw [if_pos hji] at hj; cases hj
    · rw [if_neg hji] at hj; cases hj
  · have e : (fun i => scaleU (u i) (idUse u i)) = fun i => Use.single i (u i) := by
      funext i j
      simp only [idUse]
      cases u i with
      | none => simp only [scaleU, emptyU, Use.single]; split <;> rfl
      | lin => rfl
      | grd r =>
        simp only [scaleU, smulCtx, Use.single]
        split
        · simp only [Use.smul, mul_one]
        · rfl
    rw [e]; exact SumF.single u

/-- The usage of `[t₁/x] t₂` for a linear `x`. -/
lemma SubstUse.beta {u₁ u₂ u : Fin n → Use R} (hadd : CtxAdd u₁ u₂ u) :
    SubstUse (Use.lin .: u₂) (u₁ .: idUse u₂) u := by
  refine ⟨fun i r hi => ?_, ⟨u₂, (SubstUse.id u₂).2, hadd⟩⟩
  induction i using Fin.cases with
  | zero => cases hi
  | succ i => exact (SubstUse.id u₂).1 i r hi

/-- The usage of `[t₁/x] t₂` for an `r`-graded `x` and a graded `t₁`. -/
lemma SubstUse.betaBox {r : R} {u₁ u₂ u : Fin n → Use R} (hg : Graded u₁)
    (hadd : CtxAdd (smulCtx r u₁) u₂ u) :
    SubstUse (Use.grd r .: u₂) (u₁ .: idUse u₂) u := by
  refine ⟨fun i s hi => ?_, ⟨u₂, (SubstUse.id u₂).2, hadd⟩⟩
  induction i using Fin.cases with
  | zero => exact hg
  | succ i => exact (SubstUse.id u₂).1 i s hi

